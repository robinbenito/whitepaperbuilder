{
  "name": "imagegen-whitepapergen",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@react-pdf/renderer": "^4.1.6",
    "@vercel/analytics": "^2.0.1",
    "pdf-lib": "^1.17.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^9.0.1",
    "remark-gfm": "^4.0.0"
  },
  "optionalDependencies": {
    "@sparticuz/chromium": "^131.0.0",
    "puppeteer-core": "^23.10.4"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vercel/node": "^5.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.6.3",
    "vite": "^6.0.5"
  },
  "comments": {
    "overrides": "Force patched versions of transitive deps flagged by `npm audit`. All of these are pulled in only by build/dev tooling (@vercel/node's build pipeline and tsx's esbuild); none ship in the client bundle. Each pin stays within the same major version line to avoid breaking that tooling. esbuild is scoped to tsx only so Vite keeps its own (already-safe) esbuild."
  },
  "overrides": {
    "undici": "^6.27.0",
    "minimatch": "^10.2.5",
    "path-to-regexp": "6.3.0",
    "js-yaml": "^4.2.0",
    "smol-toml": "^1.6.1",
    "ajv": "^8.20.0",
    "tsx": {
      "esbuild": "^0.28.1"
    }
  }
}
